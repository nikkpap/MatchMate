<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed reminder: sport emoji + teams in large bold, then time · channel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_vertical">
    <TextView android:id="@+id/teams"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="17sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/details"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
